# 数据库
DATABASE_URL="postgresql://jianlian:jianlian@localhost:5432/jianlian?schema=public"

# Redis（邮件发送队列与序列 worker）
REDIS_URL="redis://localhost:6379"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# 应用
APP_URL="http://localhost:3000"

# SMTP（未配置时邮件走 dry-run，仍会记录“将发送”）
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="建联 <noreply@jianlian.local>"
SMTP_SECURE="false"

# 可选 IMAP 入站（留空则关闭，可在联系人页手动登记回复）
IMAP_HOST=""
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASS=""
IMAP_SECURE="true"

# WhatsApp Cloud API 也可在「设置」页保存；环境变量作为默认值
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN="jianlian-verify"
WHATSAPP_API_VERSION="v21.0"

# 发送限速（每小时封顶，默认 20）
SEND_RATE_PER_HOUR="20"
